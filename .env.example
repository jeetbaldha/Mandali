# Copy to .env in the repository root. Keep all credentials local.
POSTGRES_DB=card_game
POSTGRES_USER=card_game
POSTGRES_PASSWORD=replace-with-a-long-local-password
DATABASE_URL=postgresql://card_game:replace-with-a-long-local-password@localhost:55432/card_game
PORT=3000
# Set to your actual browser client origins if using Flutter web.
CORS_ORIGIN=http://localhost:8080
# Optional SFU configuration, required for voice:
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
